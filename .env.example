# Supabase Configuration
# Get these values from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Spotify Configuration
# Create a Spotify app at: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id-here

# Google Cloud Vision API (for OCR)
# This should be set as a Supabase secret, not in .env
# Create at: https://console.cloud.google.com/apis/credentials
# Set in Supabase: supabase secrets set GOOGLE_VISION_API_KEY=your-key-here
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here
